{
  "name": "worx-search",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-01",

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "worx-ai-index",
      "remote": true
    }
  ],

  "ai": { "binding": "AI" },

  // KV bindings: CACHE holds ans:* + qemb:* (search worker's answer + embedding
  // cache). CONTENT holds doc:* text chunks the search worker reads to build
  // RAG context. Both written by the ingest worker; both read by search.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b7cccd00ce024ecaac6f69ddbf1d1140"
    },
    {
      "binding": "CONTENT",
      "id": "c8e9cf82653944a585c223917c70ebc8"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:3000",
    "AI_GATEWAY_ACCOUNT_ID": "659d1413091a90d93fa7097f2941b2cf",
    "AI_GATEWAY_SLUG": "worx-ai",
    // Deploy-time constants that used to live in cfg:<site>. Vectorize index
    // is dimension-locked once created; embed_model must match what the
    // index was populated with.
    "EMBED_MODEL": "@cf/baai/bge-large-en-v1.5",
    "VECTORIZE_DIMS": "1024",
    "VECTORIZE_METRIC": "cosine"
  },

  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },

  "preview_urls": false
}
