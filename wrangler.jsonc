{
  "name": "worx-search",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-01",

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "worx-ai-index",
      "remote": true
    }
  ],

  "ai": { "binding": "AI" },

  // 👇 Add CONFIG KV with both prod id and preview_id
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "2d873b13f8fd45fb924955dd598281c5",
      "preview_id": "343f19548f5d4550aa17513fd2e35f93"
    }
  ],

  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:3000"
  },

  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },

  "preview_urls": false
}
